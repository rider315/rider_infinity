# ============================================================
# Rider Infinity (RI) - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual credentials.
#   cp .env.example .env
# NEVER commit your .env file to version control.
# ============================================================

# --- MT5 Connection ---
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Trading Defaults (user selects at runtime, these are fallbacks) ---
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=M5
DEFAULT_LOT_SIZE=0.01

# --- Strategy Defaults ---
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
BB_PERIOD=20
BB_STD_DEV=2.0
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# --- Risk Management ---
MAX_RISK_PER_TRADE=1.0
MAX_DAILY_DRAWDOWN=3.0
# Fleet-wide portfolio ceiling across ALL bots combined (not per-bot).
# Keep >= number of bots you run, or most bots stay blocked.
MAX_OPEN_POSITIONS=12
# Max positions a single bot may hold on its own symbol.
MAX_POSITIONS_PER_BOT=1
MAX_SPREAD_POINTS=30
DEFAULT_SL_PIPS=50
DEFAULT_TP_PIPS=100

# --- Volatility stops & hard per-trade loss cap ---
# ATR-based stops size SL/TP to each instrument's recent volatility, with a
# minimum reward:risk ratio and a hard cap on how much any single trade may lose.
USE_ATR_STOPS=false      # off by default: lowers drawdown but can erode mean-reversion edge
ATR_PERIOD=14
ATR_SL_MULT=1.5          # SL distance = ATR_SL_MULT x ATR
MIN_RR_RATIO=1.8         # TP is at least this multiple of SL
MIN_SL_PIPS=8            # clamp: stop can never be tighter than this
MAX_SL_PIPS=60           # clamp: stop can never be wider than this
MAX_LOSS_PER_TRADE_PCT=1.0   # no single trade may risk more than this % of equity

# --- Trading-hours window (UTC) ---
# Only enter trades when UTC hour is in [start, end). 0..24 = all hours.
# Backtest + live export: Asian/off-hours (~21-07 UTC) is mostly losing/noise,
# and 00:00 UTC alone lost -$144 at a 25% win-rate. Recommended 7..20.
TRADE_HOUR_START=7
TRADE_HOUR_END=20

# --- Active trade management: breakeven + time-stop ---
# Breakeven is the key fix for the "winners banked early, losers run to the
# full stop" pattern that made avg-loss (-$13) dwarf avg-win (+$8). Once a
# trade is BREAKEVEN_TRIGGER_R of its risk (R) in profit, its stop is pulled
# to entry + BREAKEVEN_LOCK_PIPS, so a reversal exits at ~breakeven not a loss.
BREAKEVEN_ENABLED=true
BREAKEVEN_TRIGGER_R=0.6
BREAKEVEN_LOCK_PIPS=1.0
# Force-close positions held longer than this many hours (0 = disabled).
# Kills multi-day runaways that never reach SL/TP.
MAX_TRADE_HOURS=48

# --- Bot ---
MAGIC_NUMBER=123456
DRY_RUN=true

# --- News Intelligence (AI-Powered Trading Signals) ---
# Anthropic Claude API key (required for news analysis)
CLAUDE_API_KEY=your_claude_api_key_here
# Finnhub API key (required for real-time financial news)
FINNHUB_API_KEY=your_finnhub_api_key_here
# NewsAPI.org key (optional — enhances news coverage)
NEWS_API_KEY=
# Enable/disable news analysis engine
NEWS_ANALYSIS_ENABLED=true
# How often to poll news sources (seconds)
NEWS_POLLING_INTERVAL=60
# Weight of news signals in combined strategy (0.0 - 1.0)
NEWS_SIGNAL_WEIGHT=0.25
# How far back to consider news for signals (hours)
NEWS_LOOKBACK_HOURS=4
# Minimum AI confidence to generate a signal (0.0 - 1.0)
NEWS_MIN_CONFIDENCE=0.6
# Minimum impact score to analyze an article (0.0 - 1.0)
NEWS_MIN_IMPACT=0.5
# Minimum net score to trigger a signal
NEWS_SIGNAL_THRESHOLD=0.3
# How long to keep news in cache (days)
NEWS_CACHE_RETENTION_DAYS=30
# Signal mode: "combined" (weighted vote), "standalone" (independent), "both"
NEWS_MODE=both
# Custom RSS feeds (comma-separated, leave empty for defaults)
NEWS_RSS_FEEDS=

# --- Cloud Optimisation (Optional — AWS Spot Instances) ---
# Master toggle: set to true to enable the "Use Cloud" checkbox in the optimizer
AWS_CLOUD_ENABLED=false
# AWS credentials (or configure via `aws configure` CLI)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# S3 bucket for job data (auto-created during setup if empty)
AWS_CLOUD_S3_BUCKET=
# Cost controls
AWS_CLOUD_MAX_COST_PER_JOB=10.00
AWS_CLOUD_MAX_WORKERS=10
AWS_CLOUD_MAX_RUNTIME_MINS=120
# Instance type: c6a.large (2 vCPU, $~0.03/hr spot) is a good default
AWS_CLOUD_INSTANCE_TYPE=c6a.large
